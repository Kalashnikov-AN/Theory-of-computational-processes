<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="zabsu.n_threads_integration.IntegrationController"
      style="-fx-padding: 20; -fx-background-color: #f4f6f8;">

    <Label text="Численное интегрирование"
           style="-fx-font-size: 18px;" />

    <GridPane hgap="10" vgap="10">

        <Label text="a:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="aField" text="0"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="b:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="bField" text="3.14"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Разбиения:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="nField" text="1000000000"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Потоки:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="threadsField" text="4"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Функция:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="functionBox"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>


    </GridPane>

    <Button text="Вычислить"
            onAction="#onCalculate"
            style="-fx-font-size: 14px; -fx-padding: 8 20;" />

    <VBox spacing="5" alignment="CENTER">
        <Label text="Результат:"/>
        <Label fx:id="resultLabel"
               style="-fx-font-size: 16px; -fx-text-fill: #2e7d32;" />

        <Label text="Время выполнения:"/>
        <Label fx:id="timeLabel"
               style="-fx-font-size: 14px; -fx-text-fill: #1565c0;" />
    </VBox>


    <Label fx:id="statusLabel" text="Ожидание"
           style="-fx-text-fill: gray;" />

</VBox>